// Signing of local builds. Versioned default: ad hoc, no team, so anyone can build.
//
// An ad hoc build gets a new identity on every build and macOS asks for the Accessibility
// permission again. To keep it, sign with your own Apple Development certificate in
// Config/Signing.local.xcconfig (not versioned), for example:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   CODE_SIGN_IDENTITY = Apple Development

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
