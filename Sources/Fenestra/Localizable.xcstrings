      }
    },
    "Recommended: turn off the built-in macOS tiling in System Settings > Desktop & Dock > Windows." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recommandé : désactivez le placement natif de macOS dans Réglages Système > Bureau et Dock > Fenêtres."
