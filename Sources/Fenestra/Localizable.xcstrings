    "Previews need the Screen & System Audio Recording permission. Without it, Snap Assist shows the app icons. Once the permission is granted, relaunch Fenestra if macOS asks you to." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les aperçus demandent l'autorisation d'enregistrement de l'écran. Sans elle, Snap Assist affiche les icônes des applications. Une fois l'autorisation accordée, relancez Fenestra si macOS le demande."
          }
        }
      }
    },
    "Previous Display" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écran précédent"
