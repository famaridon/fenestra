{
  "sourceLanguage" : "en",
  "strings" : {
    "1. Open System Settings and allow Fenestra under Accessibility." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ouvrez les Réglages Système et autorisez Fenestra dans Accessibilité."
          }
        }
      }
    },
    "2. Drag a window to an edge or a corner of the screen." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Glissez une fenêtre vers un bord ou un coin de l'écran."
          }
        }
      }
    },
    "3. Release it: the window fills the highlighted zone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Relâchez : la fenêtre se place dans la zone affichée."
          }
        }
      }
    },
    "^[%lld binding](inflect: true) without equivalent in Fenestra (listed in the log)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld raccourci](inflect: true) sans équivalent dans Fenestra (détail dans le journal)."
          }
        }
      }
    },
    "^[%lld shortcut](inflect: true) imported from %@." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld raccourci](inflect: true) importé depuis %2$@."
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À propos"
          }
        }
      }
    },
    "Accessibility granted" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibilité autorisée"
          }
        }
      }
    },
    "Accessibility not granted" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibilité non autorisée"
          }
        }
      }
    },
    "Add to the app's MCP configuration file. These settings point to this copy of Fenestra: copy them again if you move the app." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À ajouter au fichier de configuration MCP de l'app. Ces réglages désignent cet exemplaire de Fenestra : copiez-les de nouveau si vous déplacez l'app."
          }
        }
      }
    },
    "Agents" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agents"
          }
        }
      }
    },
    "AI agents such as Claude connect to Fenestra through the Model Context Protocol (MCP), with the fenestra tool bundled in the app. They can list your displays and windows and arrange them; nothing leaves your Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les agents IA comme Claude se connectent à Fenestra par le Model Context Protocol (MCP), avec l'outil fenestra fourni dans l'app. Ils peuvent lister vos écrans et vos fenêtres et les disposer ; rien ne quitte votre Mac."
          }
        }
      }
    },
    "Allow AI agents and scripts to arrange windows" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser les agents IA et les scripts à disposer les fenêtres"
          }
        }
      }
    },
    "Arrange Window" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disposer la fenêtre"
