    },
    "The pointer stops on an outer edge, but crosses the junction between two displays, hence a wider band." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un bord extérieur le pointeur s'arrête ; à la jonction de deux écrans il passe, d'où une bande plus large."
